<launch>
  <!-- ================================================================
       Eye display joystick control launch file (_ye version)

       Starts joy_node and joy_eye_status_ye node.
       Supports both dual-eye (/left + /right) and single-eye (/eye_display) modes.

       Eye movement range args (pixels, tune to match physical display mounting):
         left_edge   : max displacement when stick is pushed left  (right eye)
         right_edge  : max displacement when stick is pushed right (right eye)
         upper_edge  : max displacement when stick is pushed up    (right eye)
         bottom_edge : max displacement when stick is pushed down  (right eye)

       Dual-eye calibration args:
         x_diff : left eye moves (edge - x_diff) pixels in X vs right eye
         y_diff : left eye moves (edge - y_diff) pixels in Y vs right eye

       Publish rate:
         duration : minimum seconds between publishes (default 0.05 = 20 Hz)

       Stick return compensation:
         snap_threshold : axes below this value are snapped to 0 (default 0.1)
       ================================================================ -->

  <!-- Eye movement range -->
  <arg name="left_edge"      default="30.0"  />
  <arg name="right_edge"     default="-30.0" />
  <arg name="upper_edge"     default="-30.0" />
  <arg name="bottom_edge"    default="30.0"  />

  <!-- Dual-eye offset calibration -->
  <arg name="x_diff"         default="30.0"  />
  <arg name="y_diff"         default="5.0"   />

  <!-- Publish rate and snap threshold -->
  <arg name="duration"       default="0.05"  />
  <arg name="snap_threshold" default="0.1"   />

  <!-- Calibration offsets: eye position when joystick is at neutral -->
  <arg name="r_offset_x"     default="10.0"  />
  <arg name="r_offset_y"     default="5.0"   />
  <arg name="l_offset_x"     default="-10.0" />
  <arg name="l_offset_y"     default="5.0"   />

  <!-- joy_node: small deadzone so tiny stick movements are detected -->
  <node pkg="joy" type="joy_node" name="joy_node">
    <param name="dev"             value="/dev/input/js0" />
    <param name="deadzone"        value="0.05" />
    <param name="autorepeat_rate" value="30" />
  </node>

  <node pkg="eye_display" type="joy_eye_status_ye.py" name="joy_eye_status" output="screen">
    <param name="left_edge"      value="$(arg left_edge)"      />
    <param name="right_edge"     value="$(arg right_edge)"     />
    <param name="upper_edge"     value="$(arg upper_edge)"     />
    <param name="bottom_edge"    value="$(arg bottom_edge)"    />
    <param name="x_diff"         value="$(arg x_diff)"         />
    <param name="y_diff"         value="$(arg y_diff)"         />
    <param name="duration"       value="$(arg duration)"       />
    <param name="snap_threshold" value="$(arg snap_threshold)" />
    <param name="r_offset_x"     value="$(arg r_offset_x)"     />
    <param name="r_offset_y"     value="$(arg r_offset_y)"     />
    <param name="l_offset_x"     value="$(arg l_offset_x)"     />
    <param name="l_offset_y"     value="$(arg l_offset_y)"     />
  </node>

</launch>
